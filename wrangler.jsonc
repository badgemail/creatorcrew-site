// Cloudflare Workers — static assets only (no Worker script).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "creatorcrew-site",
  "compatibility_date": "2026-09-01",

  // `wrangler deploy` (and `wrangler dev`) run the build first.
  "build": {
    "command": "node build.mjs"
  },

  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (with a 404 status) for unknown paths.
    "not_found_handling": "404-page"
  },

  // Preview URL: https://creatorcrew-site.<your-subdomain>.workers.dev
  "workers_dev": true,

  // The real domain, attached 12 October 2026 (launch, ahead of 2
  // November). www is attached too, so it has DNS and a certificate; a
  // dashboard Redirect Rule ("Redirect from WWW to root", 301) sends it
  // to https://creatorcrew.com.au/ (see README, "Attach creatorcrew.com.au").
  "routes": [
    { "pattern": "creatorcrew.com.au", "custom_domain": true },
    { "pattern": "www.creatorcrew.com.au", "custom_domain": true }
  ]
}
